<configuration>
  <!-- No request headers/bodies, SQL parameters or provider payloads are logged. -->
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern></encoder></appender>
  <logger name="com.ruoyi" level="INFO"/>
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.springframework.jdbc" level="WARN"/>
  <logger name="com.alibaba.druid" level="WARN"/>
  <root level="INFO"><appender-ref ref="console"/></root>
</configuration>
