[Unit]
Description=MajorPilot private daily database backup
After=majorpilot-mysql.service
[Service]
Type=oneshot
ExecStart=/bin/bash /opt/majorpilot/config/backup-pilot.sh
UMask=0077
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/majorpilot/backups
