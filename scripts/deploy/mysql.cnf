[mysqld]
basedir=/opt/majorpilot/runtime/mysql
datadir=/opt/majorpilot/data/mysql
port=13360
bind-address=127.0.0.1
socket=/opt/majorpilot/run/mysql/mysql.sock
pid-file=/opt/majorpilot/run/mysql/mysql.pid
log-error=/opt/majorpilot/logs/mysql/error.log
mysqlx=0
skip-name-resolve
local-infile=0
secure-file-priv=NULL
partial-revokes=ON
innodb-buffer-pool-size=128M
innodb-redo-log-capacity=64M
max-connections=16
max-allowed-packet=32M
table-open-cache=256
table-definition-cache=512
performance-schema=OFF
skip-log-bin
default-time-zone=+00:00
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
