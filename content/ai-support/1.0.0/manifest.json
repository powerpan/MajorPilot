  "steps": [
    {
      "stepKey": "a1-task",
      "title": "认识支持请求分类任务",
      "instructions": "LumenLearn希望把支持请求交给正确团队。你会检查一个公开说明的轻量教学分类器，不是训练大模型。数据均为合成。本工程预览尚待专业审核与真实用户计时。",
      "dependencies": [],
      "required": true,
      "responseSchemaVersion": "ai-response-v1",
      "inputSchema": {
        "type": "object",
        "properties": {
          "acknowledged": {
            "type": "boolean",
            "const": true
          },
          "taskGoal": {
            "type": "string",
            "enum": [
              "ROUTE_SUPPORT_REQUESTS",
              "GENERATE_EVERY_ANSWER",
              "ASSESS_STUDENT_ABILITY"
            ]
          }
        },
        "required": [
          "acknowledged",
          "taskGoal"
        ],
        "additionalProperties": false
      },
      "assetKeys": [
        "classifier-model"
      ],
      "operationKey": null,
      "hints": [
        {
          "level": 1,
          "text": "先区分分类路由和自动回答。"
        },
        {
          "level": 2,
          "text": "标签描述请求要交给哪个团队，不是给学生贴标签。"
        },
        {
          "level": 3,
          "text": "技术问题与概念问题可能使用相似词；最终仍需你判断请求用途。"
        }
      ],
      "hintContextFields": [],
      "evidenceFields": [
        "taskGoal"
      ]
    },
    {
      "stepKey": "a2-metrics",
      "title": "理解覆盖率与错误代价",
      "instructions": "四条真实类别T/C/S/M分别路由T/C/T/人工：只有三条自动处理，其中两条正确。比较自动准确率与覆盖率，解释你最在意哪类错误；这不是总分测验。",
      "dependencies": [
        "a1-task"
      ],
      "required": true,
      "responseSchemaVersion": "ai-response-v1",
      "inputSchema": {
        "type": "object",
        "properties": {
          "priorityMetric": {
            "type": "string",
            "enum": [
              "COVERAGE",
              "AUTO_ACCURACY",
              "RECALL"
            ]
          },
          "errorCostReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "priorityMetric",
          "errorCostReason"
        ],
        "additionalProperties": false
      },
      "assetKeys": [
        "baseline-summary"
      ],
      "operationKey": null,
      "hints": [
        {
          "level": 1,
          "text": "先写清每个比例的分子和分母。"
        },
        {
          "level": 2,
          "text": "转人工会降低覆盖率，但不等于所有错误已解决。"
        },
        {
          "level": 3,
          "text": "四条演算中，自动准确率分母为3，覆盖率分母为4；请解释你的取舍。"
        }
      ],
      "hintContextFields": [],
      "evidenceFields": [
        "priorityMetric",
        "errorCostReason"
      ]
    },
    {
      "stepKey": "a3-errors",
      "title": "检查公开练习中的错误",
      "instructions": "查看练习集的审核标签与baseline，选择8–10条需要检查的案例，至少归纳两类错误模式。转人工是拒绝自动路由，不应伪称预测正确。引用样本后写出你自己的解释。",
      "dependencies": [
        "a2-metrics"
      ],
      "required": true,
      "responseSchemaVersion": "ai-response-v1",
