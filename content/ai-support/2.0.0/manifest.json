  "steps": [
    {
      "stepKey": "a1-task",
      "title": "先认识这份工作",
      "instructions": "课程团队每天会收到求助消息。分类器把消息分为技术问题、知识理解、学习安排、学习支持。你不需要会编程：先看看自动分类哪里值得信任、哪里需要人来接手。",
      "dependencies": [],
      "required": true,
      "responseSchemaVersion": "method-response-v1",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskUnderstanding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        },
        "required": [
          "taskUnderstanding"
        ]
      },
      "assetKeys": [
        "method-guide",
        "classifier-model"
      ],
      "operationKey": null,
      "hints": [
        {
          "level": 1,
          "text": "先回看这一页的小例子。"
        },
        {
          "level": 2,
          "text": "可写出现在确定的部分和还不清楚的部分。"
        },
        {
          "level": 3,
          "text": "不要求专业术语；把你怎么想的说清楚即可。"
        }
      ],
      "hintContextFields": [
        "taskUnderstanding"
      ],
      "evidenceFields": [
        "taskUnderstanding"
      ]
    },
    {
      "stepKey": "a2-metrics",
      "title": "自动处理得多，就一定好吗？",
      "instructions": "小例子：10条消息中，系统自动处理6条，其中5条分对；另4条交给人工。5÷6描述“自动处理的里面有多少分对”，6÷10描述“有多少交给系统”。交给人工不算系统分对，也不等于系统分错。",
      "dependencies": [
        "a1-task"
      ],
      "required": true,
      "responseSchemaVersion": "method-response-v1",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accuracyMeaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "coverageMeaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "humanReviewMeaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        },
        "required": [
          "accuracyMeaning",
          "coverageMeaning",
          "humanReviewMeaning"
        ]
      },
      "assetKeys": [
        "method-guide",
        "baseline-summary"
      ],
      "operationKey": null,
      "hints": [
        {
          "level": 1,
          "text": "先问分母是谁：全部消息，还是系统已经自动处理的消息？"
        },
        {
          "level": 2,
          "text": "5和6来自自动处理组，10是全部消息；4条还要交给人工。"
        },
        {
          "level": 3,
          "text": "5/6约83.3%，6/10=60%。较少自动处理可能提高前者，却增加人工工作。"
        }
      ],
      "hintContextFields": [
        "accuracyMeaning",
        "coverageMeaning",
        "humanReviewMeaning"
      ],
      "evidenceFields": [
        "accuracyMeaning",
        "coverageMeaning",
        "humanReviewMeaning"
      ]
    },
    {
      "stepKey": "a3-errors",
      "title": "从具体错例找出值得改的地方",
      "instructions": "下载Excel，查看“原始数据”的公开练习消息、系统预测和参考标签。先找至少两条分错的消息，比较它们有什么共同点；找不到两个有共同点的错例，也可以说明为什么暂时不能概括。参考标签只是本次教学任务的对照。",
      "dependencies": [
        "a2-metrics"
      ],
      "required": true,
      "responseSchemaVersion": "method-response-v1",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "errorIds": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "errorPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "errorCost": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        },
        "required": [
          "errorIds",
          "errorPattern",
          "errorCost"
        ]
      },
      "assetKeys": [
        "method-guide",
        "practice-public"
      ],
      "operationKey": null,
      "hints": [
        {
          "level": 1,
          "text": "从公开练习表里挑出预测与参考标签不同的行。"
        },
        {
          "level": 2,
          "text": "看看两条消息是否都有相近表达、边界模糊或需要额外背景。不要只写“模型不好”。"
        },
        {
          "level": 3,
          "text": "如果两例没有共同点，可以写暂时无法概括，并分别说明错分代价。"
        }
      ],
      "hintContextFields": [
        "errorIds",
