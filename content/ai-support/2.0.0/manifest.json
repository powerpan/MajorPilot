        "errorCost"
      ],
      "evidenceFields": [
        "errorIds",
        "errorPattern",
        "errorCost"
      ]
    },
    {
      "stepKey": "a4-configure",
      "title": "选择一次有理由的改动",
      "instructions": "可以改标签说明、加入一个例子，或者调整交给人工的门槛。尽量一次只改一种；如果同时改了几种，后面就不能确定是哪一种造成变化。保持原方案也是允许的，但请解释。",
