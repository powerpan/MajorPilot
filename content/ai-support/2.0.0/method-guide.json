      "supports": [
        {
          "supportId": "ai-c1-basic",
          "version": "support-v1",
          "kind": "BASIC",
          "text": "小例子：10条消息中，系统自动处理6条，其中5条分对；另4条交给人工。5÷6描述“自动处理的里面有多少分对”，6÷10描述“有多少交给系统”。交给人工不算系统分对，也不等于系统分错。",
          "sha256": "39ae20dc93fa02462886b75bb39c738bbbbc6ae58e1760e071c92d9bab9bdec2"
        },
        {
          "supportId": "ai-c1-hint-1",
          "version": "support-v1",
          "kind": "HINT_1",
          "text": "先问分母是谁：全部消息，还是系统已经自动处理的消息？",
          "sha256": "900366085c1069dfb8d7677133cb31bb61fc4808aa2c277f048de693a0dd41fb"
        },
        {
          "supportId": "ai-c1-hint-2",
          "version": "support-v1",
          "kind": "HINT_2",
          "text": "5和6来自自动处理组，10是全部消息；4条还要交给人工。",
          "sha256": "9fff23707af4018e49519ee5c90944a786f00d9b667c1473d3fd7a201ba34717"
        },
        {
          "supportId": "ai-c1-hint-3",
          "version": "support-v1",
          "kind": "HINT_3",
          "text": "5/6约83.3%，6/10=60%。较少自动处理可能提高前者，却增加人工工作。",
          "sha256": "c5aecae42c408dc2bc6dbdb8531c7bb12cb0a5ddf4f25c2f05d2f9f9001e6e52"
        },
        {
          "supportId": "ai-c1-recovery",
          "version": "support-v1",
          "kind": "RECOVERY",
          "text": "可用已核对小例子继续：自动处理准确率5/6，覆盖率6/10；它是系统提供的，不是你的计算。",
          "sha256": "ceedf329cee045e915f81dc577b6024bbc5ef5d78a298ee7f9c286e21c8a6689"
        }
      ],
      "criteria": [
        "区分自动处理准确率5/6与覆盖率6/10。人工复核不是正确分类，未自动处理不应混入已自动分类的准确率分母。"
      ],
      "dependencies": []
    },
