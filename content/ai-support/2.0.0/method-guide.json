{
  "schemaVersion": "method-guide-v1",
  "methodVersion": "method-led-v1",
  "methodName": "错误分析与有限迭代",
  "scope": "你体验的是检查模型如何犯错、决定改什么、比较改动的代价。这里只使用固定的轻量分类器，不训练大型模型，也不证明系统已经能上线。",
  "steps": [
    {
      "stepKey": "a1-task",
      "title": "先认识这份工作",
      "introduction": "课程团队每天会收到求助消息。分类器把消息分为技术问题、知识理解、学习安排、学习支持。你不需要会编程：先看看自动分类哪里值得信任、哪里需要人来接手。",
      "fields": [
        {
          "key": "taskUnderstanding",
          "label": "你认为这次需要检查什么？",
          "help": "例如：把技术故障分成知识问题，会把消息送错给谁？也可以写现在还不确定的地方。"
        }
      ],
      "checkpointId": null,
      "transferCheckpointId": null,
      "local": null
    },
    {
      "stepKey": "a2-metrics",
      "title": "自动处理得多，就一定好吗？",
      "introduction": "小例子：10条消息中，系统自动处理6条，其中5条分对；另4条交给人工。5÷6描述“自动处理的里面有多少分对”，6÷10描述“有多少交给系统”。交给人工不算系统分对，也不等于系统分错。",
      "fields": [
        {
          "key": "accuracyMeaning",
          "label": "5÷6在说什么？",
          "help": ""
        },
        {
          "key": "coverageMeaning",
          "label": "6÷10在说什么？",
          "help": ""
        },
        {
          "key": "humanReviewMeaning",
          "label": "那4条交给人工的消息，为什么不能直接算作分对？",
          "help": ""
        }
      ],
      "checkpointId": "AI-C1",
      "transferCheckpointId": null,
      "local": null
    },
    {
      "stepKey": "a3-errors",
      "title": "从具体错例找出值得改的地方",
      "introduction": "下载Excel，查看“原始数据”的公开练习消息、系统预测和参考标签。先找至少两条分错的消息，比较它们有什么共同点；找不到两个有共同点的错例，也可以说明为什么暂时不能概括。参考标签只是本次教学任务的对照。",
      "fields": [
        {
          "key": "errorIds",
          "label": "引用哪些公开消息ID？",
          "help": ""
        },
        {
          "key": "errorPattern",
          "label": "这些消息为什么容易分错？",
          "help": "指向消息中的具体词或含义；证据不够时请直说。"
        },
        {
          "key": "errorCost",
          "label": "分错后会给谁带来什么麻烦？",
          "help": ""
        }
      ],
      "checkpointId": "AI-C2",
      "transferCheckpointId": null,
      "local": null
    },
    {
      "stepKey": "a4-configure",
      "title": "选择一次有理由的改动",
      "introduction": "可以改标签说明、加入一个例子，或者调整交给人工的门槛。尽量一次只改一种；如果同时改了几种，后面就不能确定是哪一种造成变化。保持原方案也是允许的，但请解释。",
      "fields": [
        {
          "key": "changeReason",
          "label": "你想解决哪一类问题，为什么选择这个改动？",
          "help": ""
        },
        {
          "key": "expectedTradeoff",
          "label": "你预期会变好什么，又可能多出什么代价？",
          "help": ""
        }
      ],
      "checkpointId": null,
      "transferCheckpointId": null,
      "local": null
    },
    {
      "stepKey": "a5-evaluate",
      "title": "在同一批消息上比较",
      "introduction": "点击下方“运行”，把你的设置放到同一个固定评价集中，与原方案比较。多分对一些但交给人工更多，并不是毫无代价的改进。反复尝试同一批消息，结果也不代表在新消息上一定一样好。",
      "fields": [
        {
          "key": "comparison",
          "label": "与原方案相比，准确率、覆盖率和人工工作分别怎样变了？",
          "help": ""
        },
        {
          "key": "tradeoff",
          "label": "你怎么看这个变化？",
          "help": "没有提升也可以形成合理判断。引用实际结果，不把预期当作结果。"
        }
      ],
      "checkpointId": "AI-C3",
      "transferCheckpointId": null,
      "local": null
    },
    {
      "stepKey": "a6-decision",
      "title": "交付建议，再换个情境想一想",
      "introduction": "新情境：A方案处理100条中的90条，81条正确；B处理60条，57条正确。B自动处理的准确率较高，但更多消息需要人工。不要把这道小题的数据和刚才运行的数据混在一起。",
      "fields": [
        {
          "key": "decision",
          "label": "对你刚才的方案，你建议保留、改进后再看，还是暂不使用？为什么？",
          "help": ""
        },
        {
          "key": "risk",
          "label": "还要留意什么风险？",
          "help": ""
        },
        {
          "key": "transferMode",
          "label": "这道新情境小题（可选）",
          "help": "",
          "options": {
            "ANSWER": "尝试回答",
            "SKIP": "这次先不回答，保留为未作答"
          }
        },
        {
          "key": "transfer",
          "label": "在这个新情境里，B是否一定比A好？请说明。",
          "help": ""
        }
      ],
      "checkpointId": null,
      "transferCheckpointId": "AI-C3",
      "local": null
    }
  ],
  "checkpoints": [
    {
