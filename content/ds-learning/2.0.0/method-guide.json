{
  "schemaVersion": "method-guide-v1",
  "methodVersion": "method-led-v1",
  "methodName": "探索性数据分析",
  "scope": "你体验的是理解记录、处理数据、比较结果并限制结论。没有要求写代码或训练模型，也不能凭这份观察数据证明一个做法会让人完成课程。",
  "steps": [
    {
      "stepKey": "d1-context",
      "title": "先弄清一行是什么",
      "introduction": "这里有360条合成学习记录，按学员记录学习开始时间及28天内是否完成。先下载Excel，并看“字段说明”。一行记录不等于一名新学员：重复行需要另外检查。课程、报名来源等字段已经在文件里。",
      "fields": [
        {
          "key": "unit",
          "label": "一行在记录什么？用哪个字段辨认学员？",
          "help": ""
        },
        {
          "key": "question",
          "label": "你希望通过比较回答什么问题？",
          "help": ""
        }
      ],
      "checkpointId": null,
      "transferCheckpointId": null,
      "local": null
    },
    {
      "stepKey": "d2-quality",
      "title": "重复、没开始、空白，不能一起删",
      "introduction": "例子：同一学员的两行每个字段都一样，可以考虑保留一行；只看ID相同不能断定整行重复。开始天数为0表示当天开始，空白表示没有这个数值。“没有开始”的人和“开始了但没记天数”的人也不同。",
      "fields": [
        {
          "key": "cleaningReason",
          "label": "你怎样区分这些情况，为什么这样处理？",
          "help": ""
        }
      ],
      "checkpointId": "DS-C1",
      "transferCheckpointId": null,
      "local": {
        "major": "DATA_SCIENCE",
        "resultSet": "CLEANING",
        "specificationSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "duplicatePolicy": {
              "type": "string",
              "enum": [
                "REMOVE_EXACT",
                "KEEP_ALL"
              ]
            },
            "excludedRowIds": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 7
              },
              "minItems": 0,
              "maxItems": 360,
              "uniqueItems": true
            },
            "earlyThroughDay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 27
            },
            "latestDay": {
              "type": "integer",
              "minimum": 1,
              "maximum": 28
            },
            "missingDaysPolicy": {
              "type": "string",
              "enum": [
                "EXCLUDE_FROM_COMPARISON"
              ]
            },
            "resultSet": {
              "type": "string",
              "enum": [
                "CLEANING"
              ]
            }
          },
          "required": [
            "duplicatePolicy",
            "excludedRowIds",
            "earlyThroughDay",
            "latestDay",
            "missingDaysPolicy",
            "resultSet"
          ]
        },
        "valueKeys": [
          "retainedRows",
          "uniqueLearners",
          "duplicateRowsRemoved"
        ],
        "defaultSpecification": {
          "duplicatePolicy": "REMOVE_EXACT",
          "excludedRowIds": [],
          "earlyThroughDay": 3,
          "latestDay": 28,
          "missingDaysPolicy": "EXCLUDE_FROM_COMPARISON",
          "resultSet": "CLEANING"
        }
      }
    },
    {
      "stepKey": "d3-profile",
      "title": "比较两组，先把人数算清楚",
      "introduction": "本次基础比较只看已经开始、而且开始天数有效的人。默认把0–3天开始与4–28天开始分成两组。每组完成率=该组完成人数÷该组总人数；不是除以全部学员。你也可调整分界并说明理由。",
      "fields": [
        {
          "key": "comparisonReason",
          "label": "你看到什么差异？这个结论只包括哪些人？",
          "help": ""
        }
      ],
      "checkpointId": "DS-C2",
      "transferCheckpointId": null,
      "local": {
        "major": "DATA_SCIENCE",
        "resultSet": "COMPARISON",
        "specificationSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "duplicatePolicy": {
