      "assetKeys": [
        "method-guide",
        "business-brief",
        "data-dictionary",
        "weekly-funnel"
      ],
      "operationKey": null,
      "hints": [
        {
          "level": 1,
          "text": "先用一句话说分母这群人是谁。"
        },
        {
          "level": 2,
          "text": "报名者含尚未开始的人；已开始者只是其中一部分。"
        },
        {
          "level": 3,
          "text": "40/100=40%表示报名者的完成率；40/80=50%表示已开始者的完成率，两句话都可能正确但回答不同问题。"
        }
      ],
