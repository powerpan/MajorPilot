{
  "schemaVersion": "method-guide-v1",
  "methodVersion": "method-led-v1",
  "methodName": "学习流程分析与行动验证",
  "scope": "你体验的是用人数和比例确定值得先处理的问题、区分现象与原因、设计下一步。它不是统计考试，也不要求商科背景；商业分析还有财务、定价等本案例没有覆盖的工作。",
  "steps": [
    {
      "stepKey": "b1-context",
      "title": "先弄清比例在回答什么",
      "introduction": "小例子：100人报名，80人开始，40人完成。40÷100回答“报名的人中多少完成”，40÷80回答“开始的人中多少完成”。主案例有第1–6批与第7–12批，每个人都观察报名后28天；这是不同批次的人，不是同一批人的前后变化。",
      "fields": [
        {
          "key": "enrollmentRate",
          "label": "40÷100在说什么？",
          "help": ""
        },
        {
          "key": "starterRate",
          "label": "40÷80在说什么？",
          "help": ""
        },
        {
          "key": "cohortMeaning",
          "label": "为什么不能把两批完成率差异直接解释为同一个人变差了？",
          "help": ""
        }
      ],
      "checkpointId": "BA-C1",
      "transferCheckpointId": null,
      "local": null
    },
    {
      "stepKey": "b2-metric",
      "title": "沿着学习流程找一个值得先处理的地方",
      "introduction": "Excel给出报名、首课、首周活跃、开始作业、提交作业、完成的人数。选相邻两步：后一步人数÷前一步人数。再看有多少人没有继续。先加总人数再算比例，不平均小组的百分比；也别把比例最低直接当作原因。",
      "fields": [
        {
          "key": "focusReason",
          "label": "你选择先关注哪一步，为什么？",
          "help": ""
        },
        {
          "key": "otherTransition",
          "label": "再比较至少一个其他环节：写出两期人数和比例，为什么不先选它？",
          "help": ""
        }
      ],
      "checkpointId": null,
      "transferCheckpointId": null,
      "local": {
        "major": "BUSINESS_ANALYTICS",
        "resultSet": "FUNNEL",
