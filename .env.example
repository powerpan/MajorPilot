# Copy variable names only; configure-local generates separate random local credentials.
MAJORPILOT_AI_PROVIDER=bailian
# Fake by default. Provider selection alone never enables live paid calls.
MAJORPILOT_AI_MODE=fake
# Technical tutorials only; additionally restricted to the local Spring profile.
MP_P2_DEMO_ENABLED=false
# Local authenticated engineering previews only; never marks REVIEW content published.
MP_CONTENT_PREVIEW_ENABLED=false
# Local complete product, only for individually owner-authorized immutable Task Versions.
MP_LOCAL_PRODUCT_ENABLED=false
# Independent opt-in for paid task hints; ordinary tests keep this false.
MP_EXPERIENCE_AI_ENABLED=false
# Independent report opt-in; historical previews require an exact audited adoption first.
MP_REPORT_AI_ENABLED=false
MP_REPORT_AI_PROVIDER=BAILIAN
# Report quality is configured separately from realtime hints. No automatic cheaper-model fallback.
MP_REPORT_AI_MODEL=qwen3.8-max-0902
MP_REPORT_AI_TIMEOUT_MS=900000
MP_REPORT_AI_MAX_OUTPUT_TOKENS=32768
MP_REPORT_AI_THINKING_BUDGET_TOKENS=32768
MP_REPORT_AI_MAX_RESPONSE_BYTES=1048576
# Strict method-report output for Bailian; no silent format downgrade.
# DeepSeek defaults to JSON_OBJECT; JSON_SCHEMA is not enabled for that provider.
MP_REPORT_AI_OUTPUT_FORMAT=JSON_SCHEMA
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
MP_DB_URL=jdbc:mysql://127.0.0.1:13306/majorpilot?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
MP_DB_USERNAME=majorpilot
MP_DB_PASSWORD=
MP_DB_ROOT_PASSWORD=
MP_REDIS_HOST=127.0.0.1
MP_REDIS_PORT=16380
MP_REDIS_PASSWORD=
MP_ADMIN_TOKEN_SECRET=
MP_CSRF_SECRET=
MP_P0_STUDENT_PASSWORD=
MP_P0_ADMIN_PASSWORD=
MP_STUDENT_ORIGIN=http://localhost:15173
MP_SMTP_HOST=127.0.0.1
MP_SMTP_PORT=11025
