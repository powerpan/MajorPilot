{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majorpilot.invalid/schemas/task-manifest-v3.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "task-manifest-v3"
    },
    "taskVersionId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "contentKind": {
      "enum": [
        "DEMO",
        "MAJOR"
      ]
    },
    "majorCode": {
      "enum": [
        "AI",
        "DATA_SCIENCE",
        "BUSINESS_ANALYTICS",
        null
      ]
    },
    "demoKey": {
      "enum": [
        "DEMO_TABLE",
        "DEMO_COMPARE",
        null
      ]
    },
    "versionCode": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scenario": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 6,
      "minItems": 1
    },
    "estimatedMinutes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      },
      "required": [
        "minimum",
        "maximum"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assetKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9./-]{0,200}$"
          },
          "visibility": {
            "enum": [
              "PUBLIC",
              "PRIVATE"
            ]
          },
          "mediaType": {
            "enum": [
              "application/json",
              "text/csv",
              "text/plain"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        },
        "required": [
          "assetKey",
          "path",
          "visibility",
          "mediaType",
          "sha256",
          "byteLength"
        ]
      },
      "maxItems": 30
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            },
            "maxItems": 30
          },
          "required": {
            "type": "boolean"
          },
          "responseSchemaVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "inputSchema": {
            "type": "object",
            "required": [
              "type",
              "properties",
              "required",
              "additionalProperties"
            ],
            "properties": {
              "type": {
                "const": "object"
              },
              "properties": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 30,
                "additionalProperties": {
                  "type": "object"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "additionalProperties": {
                "const": false
              }
            },
            "additionalProperties": false
          },
          "assetKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            },
            "maxItems": 30
          },
          "operationKey": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "hints": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                }
              },
              "required": [
                "level",
                "text"
              ]
            }
          },
          "hintContextFields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxItems": 30
          },
          "evidenceFields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxItems": 30
          }
        },
        "required": [
          "stepKey",
          "title",
          "instructions",
          "dependencies",
          "required",
          "responseSchemaVersion",
          "inputSchema",
          "assetKeys",
          "operationKey",
          "hints",
          "hintContextFields",
          "evidenceFields"
        ]
      },
      "maxItems": 30,
      "minItems": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "stepKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "engineType": {
            "enum": [
              "DEMO_SUMMARY",
              "FROZEN_CLASSIFIER",
              "SQL_TEMPLATE",
              "RULES",
              "DATA_ANALYSIS"
            ]
          },
          "engineVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "parametersSchema": {
            "type": "object",
            "required": [
              "type",
              "properties",
              "required",
              "additionalProperties"
            ],
            "properties": {
              "type": {
                "const": "object"
              },
              "properties": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 30,
                "additionalProperties": {
                  "type": "object"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "additionalProperties": {
                "const": false
              }
            },
            "additionalProperties": false
          },
          "resultSchema": {
            "type": "object",
            "required": [
              "type",
              "properties",
              "required",
              "additionalProperties"
            ],
            "properties": {
              "type": {
                "const": "object"
              },
              "properties": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 30,
                "additionalProperties": {
                  "type": "object"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "additionalProperties": {
                "const": false
              }
            },
            "additionalProperties": false
          },
          "maxEvaluations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "publicAssetKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            },
            "maxItems": 30
          },
          "privateAssetKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            },
            "maxItems": 30
          },
          "datasetAssetKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "inputBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "parameterKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "sourceStepKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "sourceField": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "parameterKey",
                "sourceStepKey",
                "sourceField"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 30
          },
          "ownResponseBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "parameterKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "sourceField": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "parameterKey",
                "sourceField"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 30
          }
        },
        "required": [
          "operationKey",
          "stepKey",
          "engineType",
          "engineVersion",
          "parametersSchema",
          "resultSchema",
          "maxEvaluations",
          "publicAssetKeys",
          "privateAssetKeys",
          "datasetAssetKey",
          "inputBindings",
          "ownResponseBindings"
        ]
      },
      "maxItems": 30
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questionSetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "type",
            "properties",
            "required",
            "additionalProperties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 30,
              "additionalProperties": {
                "type": "object"
              }
            },
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "additionalProperties": {
              "const": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "questionSetVersion",
        "instructions",
        "inputSchema"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "TECHNICAL_DEMO",
            "PROFESSIONAL"
          ]
        },
        "checkKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "professionalReviewRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "checkKeys",
        "professionalReviewRequired"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "taskVersionId",
    "contentKind",
    "majorCode",
    "demoKey",
    "versionCode",
    "title",
    "scenario",
    "goals",
    "estimatedMinutes",
    "assets",
    "steps",
    "operations",
    "reflection",
    "review"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "contentKind": {
            "const": "DEMO"
          }
        }
      },
      "then": {
        "properties": {
          "majorCode": {
            "type": "null"
          },
          "demoKey": {
            "enum": [
              "DEMO_TABLE",
              "DEMO_COMPARE"
            ]
          },
          "review": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "TECHNICAL_DEMO"
              },
              "professionalReviewRequired": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "majorCode": {
            "enum": [
              "AI",
              "DATA_SCIENCE",
              "BUSINESS_ANALYTICS"
            ]
          },
          "demoKey": {
            "type": "null"
          },
          "estimatedMinutes": {
            "type": "object",
            "properties": {
              "minimum": {
                "const": 45
              },
              "maximum": {
                "const": 60
              }
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "PROFESSIONAL"
              },
              "professionalReviewRequired": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
