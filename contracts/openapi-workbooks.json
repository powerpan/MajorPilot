{
  "openapi": "3.1.0",
  "info": {
    "title": "MajorPilot version-bound teaching workbooks",
    "version": "7.2.0",
    "description": "Additive to product-flow API. Derived PUBLIC material; no task mutation or release grant."
  },
  "paths": {
    "/api/app/v1/experience-runs/{id}/workbooks": {
      "get": {
        "operationId": "listRunWorkbooks",
        "security": [
          {
            "StudentCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public metadata only; empty for unsupported versions.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "maxItems": 1,
                      "items": {
                        "$ref": "#/components/schemas/WorkbookMetadata"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "requestId",
                        "apiVersion"
                      ],
                      "properties": {
                        "requestId": {
                          "type": "string"
                        },
                        "apiVersion": {
                          "type": "string",
                          "const": "v1"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Student session required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Account inactive or content access disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Run not owned, content withdrawn or workbook absent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Content integrity validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/app/v1/experience-runs/{id}/workbooks/{assetKey}": {
      "get": {
        "operationId": "downloadRunWorkbook",
        "description": "Active student, owner and exact pinned Task Version/manifest hash required. Paused/closed owned runs may read available materials. No progress, quota or model mutation; no upload.",
        "security": [
          {
            "StudentCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            }
          },
          {
            "name": "assetKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "const": "materials"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Actual XLSX bytes. Error responses are JSON, never named .xlsx.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Content-Disposition": {
                "description": "attachment with server-controlled UTF-8 filename",
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5242880
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "const": "nosniff"
                }
              },
              "X-Content-SHA256": {
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Student session required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Account inactive or content access disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Run not owned, content withdrawn or workbook absent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Content integrity validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "StudentCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "MP_SESSION"
      }
    },
    "schemas": {
      "WorkbookMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetKey",
          "filename",
          "workbookVersion",
          "mediaType",
          "byteLength",
          "rowCount",
          "sha256",
          "taskVersionId"
        ],
        "properties": {
          "assetKey": {
            "type": "string",
            "const": "materials"
          },
          "filename": {
            "type": "string",
            "pattern": "^[^/\\\\\\r\\n]+\\.xlsx$",
            "maxLength": 105
          },
          "workbookVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "mediaType": {
            "type": "string",
            "const": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5242880
          },
          "rowCount": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "taskVersionId": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          }
        }
      }
    }
  }
}
