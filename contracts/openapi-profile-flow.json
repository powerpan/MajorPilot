{
  "openapi": "3.1.0",
  "info": {
    "title": "MajorPilot background profile and questionnaire skip amendment",
    "version": "7.4.0",
    "description": "Four-change scope dated 2026-11-14. Drafts and submitted versions are separate; missing answers never become defaults. Security prerequisites remain authoritative. Payment demonstration is frontend-only and has no API."
  },
  "paths": {
    "/api/app/v1/profile": {
      "get": {
        "operationId": "readBackgroundProfile",
        "description": "Latest submitted profile and independent draft. draftRevision remains monotonic even when draft is absent.",
        "security": [
          {
            "StudentSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Owned active Student profile state; no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ProfileState"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Safe failure; revisions may identify a newer draft or submitted profile. No silent overwrite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe failure; revisions may identify a newer draft or submitted profile. No silent overwrite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Safe failure; revisions may identify a newer draft or submitted profile. No silent overwrite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe failure; revisions may identify a newer draft or submitted profile. No silent overwrite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Safe failure; revisions may identify a newer draft or submitted profile. No silent overwrite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Safe failure; revisions may identify a newer draft or submitted profile. No silent overwrite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Safe failure; revisions may identify a newer draft or submitted profile. No silent overwrite.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
