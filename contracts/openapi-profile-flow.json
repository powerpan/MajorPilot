  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string"
          },
          "apiVersion": {
            "const": "v1",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "apiVersion"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fieldErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "code"
                  ]
                },
                "minItems": 0,
                "maxItems": 100
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "currentRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "currentProfileVersion": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": []
              }
            },
            "required": [
              "code",
              "message",
              "fieldErrors",
              "retryable"
            ]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "requestId"
            ]
          }
        },
        "required": [
          "error",
          "meta"
        ]
      },
      "DraftAnswers": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "applicationStage": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "EXPLORING",
                  "RESEARCHING_PROGRAMS",
                  "PREPARING_APPLICATION",
                  "APPLIED",
                  "HOLDING_OFFERS"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "targetIntakeWindow": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "WITHIN_6_MONTHS",
                  "MONTHS_6_TO_12",
                  "MONTHS_12_TO_24",
                  "AFTER_24_MONTHS",
                  "UNSURE"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "targetRegions": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "HONG_KONG",
                    "SINGAPORE",
                    "UNITED_KINGDOM"
                  ]
                },
                "minItems": 0,
                "maxItems": 3,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "currentField": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "COMPUTING_ENGINEERING",
                  "MATHEMATICS_STATISTICS",
                  "BUSINESS_ECONOMICS",
                  "NATURAL_LIFE_SCIENCES",
                  "SOCIAL_HUMANITIES",
                  "OTHER"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "currentFieldText": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "consideredMajors": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "AI",
                    "DATA_SCIENCE",
                    "BUSINESS_ANALYTICS"
                  ]
                },
                "minItems": 0,
                "maxItems": 3,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "majorFamiliarity": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "AI": {
                    "type": "string",
                    "enum": [
                      "UNFAMILIAR",
                      "READ_OVERVIEW",
                      "COURSE_OR_PROJECT",
                      "PRACTICAL_EXPERIENCE"
                    ]
                  },
                  "DATA_SCIENCE": {
                    "type": "string",
                    "enum": [
                      "UNFAMILIAR",
                      "READ_OVERVIEW",
                      "COURSE_OR_PROJECT",
                      "PRACTICAL_EXPERIENCE"
                    ]
                  },
                  "BUSINESS_ANALYTICS": {
                    "type": "string",
                    "enum": [
                      "UNFAMILIAR",
                      "READ_OVERVIEW",
                      "COURSE_OR_PROJECT",
                      "PRACTICAL_EXPERIENCE"
                    ]
                  }
                },
                "required": []
              },
              {
                "type": "null"
              }
            ]
          },
          "foundationSelfView": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "PROGRAMMING": {
                    "type": "string",
                    "enum": [
                      "UNEXPOSED",
                      "BEGINNER",
                      "BASIC_TASKS",
                      "FAMILIAR"
                    ]
                  },
                  "MATHEMATICS_STATISTICS": {
                    "type": "string",
                    "enum": [
                      "UNEXPOSED",
                      "BEGINNER",
                      "BASIC_TASKS",
                      "FAMILIAR"
                    ]
                  },
                  "DATA_ANALYSIS": {
                    "type": "string",
                    "enum": [
                      "UNEXPOSED",
                      "BEGINNER",
                      "BASIC_TASKS",
                      "FAMILIAR"
                    ]
                  },
                  "BUSINESS_PROBLEMS": {
                    "type": "string",
                    "enum": [
                      "UNEXPOSED",
                      "BEGINNER",
                      "BASIC_TASKS",
                      "FAMILIAR"
                    ]
                  }
                },
                "required": []
              },
              {
                "type": "null"
              }
            ]
          },
          "scenarioPreference": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "majorCode": {
                      "type": "string",
                      "enum": [
                        "AI",
                        "DATA_SCIENCE",
                        "BUSINESS_ANALYTICS"
                      ]
                    },
                    "rank": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    }
                  },
                  "required": [
                    "majorCode",
                    "rank"
                  ]
                },
                "minItems": 0,
                "maxItems": 3,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "workElements": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "CHECK_ERRORS",
                    "ADJUST_EXPERIMENTS",
                    "CLEAN_DATA",
                    "INTERPRET_CHARTS",
                    "DEFINE_METRICS",
                    "PROPOSE_ACTIONS",
                    "COMMUNICATE_CONCLUSIONS"
                  ]
                },
                "minItems": 0,
                "maxItems": 3,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "decisionUncertainties": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "DAILY_WORK",
                    "INTEREST",
                    "LEARNING_DIFFICULTY",
                    "CURRENT_FOUNDATION",
                    "MAJOR_DIFFERENCES",
                    "FUTURE_DEVELOPMENT"
                  ]
                },
                "minItems": 0,
                "maxItems": 2,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "mainQuestion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "acquisitionChannel": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "FRIEND_OR_CLASSMATE",
                  "SOCIAL_MEDIA",
                  "SEARCH",
                  "COMMUNITY",
                  "OTHER",
                  "DECLINED"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": []
      },
      "QuestionnaireVersion": {
        "const": "decision-profile-v1",
        "type": "string"
      },
      "Recommendation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decisionProfileId": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "recommendationId": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "profileVersion": {
            "type": "integer",
            "minimum": 1
          },
          "questionnaireVersion": {
            "$ref": "#/components/schemas/QuestionnaireVersion"
          },
          "ruleVersion": {
            "const": "initial-recommendation-v1",
            "type": "string"
          },
          "explanationVersion": {
            "const": "initial-template-v1",
            "type": "string"
          },
          "primaryMajor": {
            "type": "string",
            "enum": [
              "AI",
              "DATA_SCIENCE",
              "BUSINESS_ANALYTICS"
            ]
          },
          "alternativeMajors": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "AI",
                "DATA_SCIENCE",
                "BUSINESS_ANALYTICS"
              ]
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "minItems": 2,
            "maxItems": 4
          },
          "tieDetected": {
            "type": "boolean"
          },
          "tieBreakRule": {
            "type": "string",
            "enum": [
              "RANK",
              "CONSIDERED",
              "STRONG_COUNT",
              "MEDIUM_COUNT",
              "FAMILIARITY",
              "FIXED_ORDER"
            ]
          },
          "majorDifferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MajorDifference"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "supportNotes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "explanationStatus": {
            "const": "STRUCTURED_ONLY",
            "type": "string"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "canRegister": {
            "type": "boolean"
          },
          "availability": {
