    "securitySchemes": {
      "IntakeSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "MP_INTAKE",
        "description": "Opaque secret, HttpOnly, SameSite=Lax; public API path only. Seven-day inactivity."
      },
      "StudentSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "MP_SESSION",
        "description": "Opaque HttpOnly cookie scoped /api/app/v1; does not accept RuoYi administrator JWT."
      },
      "CsrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Signed, actor-bound token matching readable MP_PUBLIC_CSRF or MP_CSRF cookie; exact local Origin required on writes."
      }
    },
    "parameters": {
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "const": "http://localhost:15173"
        },
        "description": "Local P1 exact-origin allowlist; deployment is a separate gate."
      },
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        }
      },
      "PublicId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      }
    }
  }
