{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "MajorPilot P0 local-only probe API",
    "version": "0.0.0-p0",
    "description": "Engineering probes enabled only under the loopback p0 Spring profile. This is not the P1 registration API or P7 privacy implementation. See docs/12 for eventual product contracts. Cookie Path restricts transmission, never substitutes for authentication. Local HTTP cookies are SameSite=Lax and host-only; production Secure handling is a later gate."
  },
  "servers": [
    {
      "url": "http://localhost:18080",
      "description": "Local backend only; browser should use configured same-origin frontend proxy"
    }
  ],
  "tags": [
    {
      "name": "student-p0"
    },
    {
      "name": "operator-p0"
    }
  ],
  "paths": {
    "/api/app/v1/p0/mail": {
      "post": {
        "operationId": "p0Mail",
        "summary": "Send synthetic verification or reset email to local Mailpit only",
        "tags": ["student-p0"],
        "security": [{"StudentSession": [], "StudentCsrfCookie": [], "CsrfHeader": []}],
        "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/Origin"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MailInput"}}}
        },
        "responses": {
          "200": {
            "description": "Synthetic message accepted by local mail catcher; no real account token",
            "headers": {"X-Request-Id": {"schema": {"type": "string"}}},
            "content": {"application/json": {"schema": {
              "type": "object", "additionalProperties": false, "required": ["data", "meta"],
              "properties": {"data": {"$ref": "#/components/schemas/MailResult"}, "meta": {"$ref": "#/components/schemas/Meta"}}
            }}}
          },
          "default": {"$ref": "#/components/responses/Failure"}
        }
      }
    },
    "/api/public/v1/p0/health": {
      "get": {
        "operationId": "p0Health",
        "summary": "P0 database, Redis and migration readiness; model and mail are not checked",
        "tags": [
          "student-p0"
        ],
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Database, Redis and migration checks are UP; model and mail remain NOT_CHECKED",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "At least one database, Redis or migration check is DOWN; health report is retained rather than replaced by an error envelope",
            "headers": {"X-Request-Id": {"schema": {"type": "string"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthEnvelope"}}}
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        }
      }
    },
    "/api/public/v1/auth/csrf": {
      "get": {
        "operationId": "publicCsrf",
        "summary": "Issue public signed CSRF value; HttpOnly Intake cookie remains private",
        "tags": [
